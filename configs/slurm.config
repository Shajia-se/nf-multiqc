params {
  queue        = "cpu_p"
  extra_mounts = ""
}

process {
  executor = "slurm"
  queue = params.queue
  clusterOptions = "--qos=cpu_normal --nice=10000 --mail-type=END,FAIL --mail-user=${params.mail_user}"

  cpus   = params.cpus
  memory = params.memory
  time   = params.time

  container = params.container_multiqc
  // MultiQC receives scan locations as strings, not staged path inputs.
  containerOptions = {
    def roots = [params.flat_output_root ?: params.pipelines_root]
    if (params.multiqc_extra_paths) {
      roots.addAll(params.multiqc_extra_paths.toString().split(',').collect { it.trim() })
    }
    if (params.multiqc_config) roots << params.multiqc_config
    roots.findAll { it }.collect { new File(it.toString()).absoluteFile }
      .findAll { it.exists() }
      .collect { it.isDirectory() ? it.path : it.parent }
      .unique().collect { "--bind '${it}'" }.join(' ')
  }
}

singularity {
  enabled    = true
  autoMounts = true
  runOptions = params.extra_mounts
}
